# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# archived/superseded etudes — never commit (see CLAUDE.md)
/trash/

# dev tooling, docs and copy sources — not part of the landing app
/.agents/
/.claude/
/.claude.md
/.dev_log/
/.impeccable/
/.vscode/
/AGENTS.md
/CLAUDE.md
/DESIGN.md
/PRODUCT.md
/content/
/docs/
/parse-tokens.js
/skills-lock.json

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
